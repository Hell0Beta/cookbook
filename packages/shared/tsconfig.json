{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    // DOM lib for the URL global — exists in both Node ≥10 and browsers;
    // shared code runs in both (web bundle + api).
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src"]
}
