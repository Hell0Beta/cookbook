# Cookbook app environment (development defaults)
# Copy to .env and adjust. See docs/development.md §0 for constraints.

# --- apps/api ---
# Local data directory (SQLite DB + uploaded images live here)
DATA_DIR=./data
PORT=3001

# Session signing secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me

# OpenRouter (LLM — used from Phase 3/4 onward; unused in Phase 1)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional Spoonacular flag (disabled by default per development.md §0/§4)
SPOONACULAR_ENABLED=false
SPOONACULAR_API_KEY=

# --- apps/web ---
# NEXT_PUBLIC_API_URL is inlined at BUILD time. Leave empty in dev (the client
# falls back to ${browser-hostname}:3001); for a dockerized deploy set it to
# the public API URL and pass it as a build arg:
#   docker compose build --build-arg NEXT_PUBLIC_API_URL=https://cookbook.<tailnet>.ts.net:8443
# (compose reads NEXT_PUBLIC_API_URL from the .env next to docker-compose.yml)
NEXT_PUBLIC_API_URL=

# --- docker deploy (docker-compose.yml) ---
# Compose reads these from the same .env. WEB_ORIGIN must list the tailnet
# origin explicitly — hostname origins don't match the private-IP CORS rule.
# WEB_ORIGIN=https://cookbook.<tailnet>.ts.net

