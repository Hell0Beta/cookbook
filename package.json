{
  "name": "cookbook",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cookbook/shared build && pnpm --parallel --filter @cookbook/web --filter @cookbook/api dev",
    "qr": "node scripts/qr.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @cookbook/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @cookbook/api db:generate",
    "db:migrate": "pnpm --filter @cookbook/api db:migrate",
    "db:push": "pnpm --filter @cookbook/api db:push"
  },
  "devDependencies": {
    "qrcode-terminal": "^0.12.0"
  }
}
